<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <TextView
        android:id="@+id/detailTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <TextView
        android:id="@+id/detailAuthor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <TextView
        android:id="@+id/detailYear"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <Button
        android:id="@+id/ulubione"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ulubione" />

    <Button
        android:id="@+id/powrot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Powrót" />

    <Button
        android:id="@+id/dodajOpinieButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Dodaj opinię" />

    <EditText
        android:id="@+id/opiniaEditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Napisz opinię"
        android:minLines="3" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/opinieRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

</LinearLayout>